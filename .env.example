# =====================================================================
# Aria SafeOps — نمونهٔ متغیرهای محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را پر کنید.
# .env هرگز نباید commit شود (در .gitignore قرار دارد).
# =====================================================================

# ---- Demo / bootstrap users (seed) ----
# admin@hse.aria-ai.ir / ChangeMe!Admin1
# issuer@hse.aria-ai.ir / ChangeMe!Issuer1
#
# کاربر راه‌انداز مشترک هر دو سامانه:
#   نام کاربری: alireza
#   لوکال (ARIA_RUNTIME خالی یا local): alireza
#   Production (ARIA_RUNTIME=production در docker-compose.yml): Aria7x!Alireza#Ops2026
# برای بازنویسی رمز، مقدار زیر را پر کنید:
# SEED_ALIREZA_PASSWORD=

# ---- App ----
APP_ENV=prod
APP_DEBUG=0
# با دستور زیر بسازید: openssl rand -hex 32
APP_SECRET=changeme-generate-with-openssl-rand-hex-32
APP_URL=https://hse.aria-ai.ir
# تگ ایمیج برای Deploy (توسط CI/CD ست می‌شود؛ برای اجرای محلی latest کافیست)
IMAGE_TAG=latest
# Nginx در Production به‌عنوان پروکسی فوری اعتماد می‌شود
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# ---- Database (PostgreSQL 16 + TimescaleDB) ----
POSTGRES_DB=aria_safeops
POSTGRES_USER=aria_safeops
# رمز قوی و یکتا — هرگز مقدار پیش‌فرض را در Production نگه ندارید
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"

# ---- Redis (کش + Symfony Messenger transport) ----
# طبق قاعدهٔ امنیتی پروژه: Redis همیشه باید رمز داشته باشد و هرگز به 0.0.0.0 اکسپوز نشود
REDIS_PASSWORD=changeme-strong-password
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# ---- JWT Auth (LexikJWTAuthenticationBundle) ----
JWT_PASSPHRASE=changeme
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_TTL=28800

# ---- AI Gateway ----
# true = بستهٔ دانش HSE روی همین سرور. اگر AI_GATEWAY_URL پر شود به سرویس مرکزی می‌رود.
AI_GATEWAY_ENABLED=true
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_MS=8000

# ---- PetroOps integration (equipment_tag holds) ----
PETROOPS_INTEGRATION_KEY=changeme-petroops-integration-key

# ---- HSE Vision ----
VISION_SIMULATOR=true
VISION_GATEWAY_URL=
VISION_INGEST_KEY=

# ---- Mercure (Real-time اعلان‌ها) ----
MERCURE_ENABLED=true
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://hse.aria-ai.ir/.well-known/mercure
MERCURE_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# ---- ایمیل/اعلان (فاز ۲) ----
MAILER_DSN=smtp://localhost
